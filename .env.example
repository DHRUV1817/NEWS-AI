# newsninja — environment template
#
# Copy to .env at the repository root (the package reads ../.env relative to
# api/) and fill in GROQ_API_KEY. Every other value has a working default.
#
# This file mirrors api/newsninja/config.py exactly: any name not listed here
# is ignored by Settings.

# --- required -----------------------------------------------------------

# Free key from console.groq.com/keys. Used for extraction, synthesis,
# translation, and — when enabled below — Orpheus speech.
GROQ_API_KEY=""

# --- optional: Reddit ---------------------------------------------------

# Without these the Reddit source reports itself unavailable and the run
# proceeds on Google News alone; the CLI says so rather than failing. Reddit's
# public search.json returns 403, so a free "script" app is the only route:
# reddit.com/prefs/apps -> create app -> type "script".
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""

# Reddit requires a descriptive user agent. Default:
# "newsninja/3.0 (portfolio project)"
# REDDIT_USER_AGENT="newsninja/3.0 (portfolio project)"

# --- optional: audio ----------------------------------------------------

# Orpheus is a better-sounding upgrade over gTTS, but covers English and Saudi
# Arabic only, and returns HTTP 400 model_terms_required until the model terms
# are accepted at console.groq.com. Any failure falls back to gTTS, so turning
# this on before accepting the terms changes nothing audible. Default: false.
# ENABLE_ORPHEUS="false"

# --- optional: runtime --------------------------------------------------

# SQLite response cache, relative to the working directory.
# Default: .cache/newsninja.sqlite
# CACHE_PATH=".cache/newsninja.sqlite"

# HTTP timeout in seconds for source fetches. Default: 30
# REQUEST_TIMEOUT=30

# --- optional: service --------------------------------------------------

# Origins permitted to call this service from a browser, as a JSON list.
# Empty by default: no cross-origin access is a safe failure, "*" is not.
# ALLOWED_ORIGINS="[]"

# How long a request handler may sit inside the token limiter before the
# service answers 429 instead. Keeps a full budget from becoming a connection
# held open until the platform proxy severs it. Default: 5.0
# API_MAX_WAIT_SECONDS=5.0

# Per-IP request ceiling. Stops one client hammering the service; it does not
# protect the shared token budget — api_max_wait_seconds does that. Default: 10
# RATE_LIMIT_PER_MINUTE=10

# Read the client address from X-Forwarded-For. Off by default: the header is
# spoofable unless the platform overwrites it, and trusting it blindly turns
# the per-IP window into decoration. Default: false
# TRUST_PROXY_HEADERS=false
